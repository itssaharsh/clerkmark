# Clerkmark — environment (every variable is optional; the sample runs with none of them)

# CourtListener v4 citation-lookup token (Free Law Project). Adds CourtListener as a second
# source for citations the free corpus does not hold (volumes beyond CAP coverage).
# Without it the memo heading reads "CourtListener: not configured". 60 citations/min.
COURTLISTENER_TOKEN=

# Anthropic API key for the ADVISORY column (claude-haiku-4-5-20251001; one call per verified
# row with a quote, at most 20 per memo, 15 s timeout). Never changes a class.
# Without it every row reads "Advisory: not run".
ANTHROPIC_API_KEY=

# 1 = serve everything from the on-disk CAP cache (seed/cache/cap); no network calls.
# The seeded sample runs fully offline; memo.offline = true.
CITEMEMO_OFFLINE=

# Writable cache directory for fetched CAP files. Default: seed/cache/cap when writable,
# else /tmp/citememo-cache (Vercel's filesystem is read-only except /tmp). The committed
# seed cache is always readable as a fallback.
CITEMEMO_CACHE_DIR=
